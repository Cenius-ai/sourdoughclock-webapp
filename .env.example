# SourDoughClock environment variables.
#
# Nothing in this file is loaded automatically - SourDoughClock reads the
# process environment only (export these in your shell, or set them inline).
# There are no secrets or API keys: the tool is fully offline.

# Optional. Path to the JSON store. Leave empty to use ~/.sourdoughclock.json.
# Useful for demos, tests and keeping several fake bakeries apart:
#   SDC_DATA=./.sdc-demo/sourdoughclock.json
SDC_DATA=
